# Web Studio 99 - Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH STRONG PRODUCTION SECRETS
# NEVER COMMIT THE ACTUAL .env FILE TO GIT

# Database Configuration (PostgreSQL in production, SQLite in local dev)
DATABASE_URL="postgresql://ws99_user:STRONG_SECURE_PASSWORD@localhost:5432/webstudio99_prod?schema=public"

# App & Runtime
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_URL="https://webstudio99.xyz"

# Authentication & Session Security (Generate with: openssl rand -base64 48)
NEXTAUTH_SECRET="REPLACE_WITH_MIN_64_CHARACTER_RANDOM_SECRET_KEY_FOR_JWT_SESSION"
JWT_SECRET="REPLACE_WITH_MIN_64_CHARACTER_RANDOM_SECRET_KEY_FOR_JWT_SESSION"

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="REPLACE_WITH_RAZORPAY_SECRET"
RAZORPAY_WEBHOOK_SECRET="REPLACE_WITH_WEBHOOK_SIGNATURE_SECRET"

# SMTP / Email Notification System
SMTP_HOST="smtp.titan.email"
SMTP_PORT=465
SMTP_USER="supports@webstudio99.xyz"
SMTP_PASSWORD="REPLACE_WITH_SECURE_EMAIL_PASSWORD"
SMTP_FROM_EMAIL="supports@webstudio99.xyz"
SMTP_SECURE=true

# Google reCAPTCHA v3
RECAPTCHA_SECRET_KEY="REPLACE_WITH_RECAPTCHA_SECRET_KEY"
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI"

# Google OAuth (Client Portal Social Login)
GOOGLE_CLIENT_ID="REPLACE_WITH_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="REPLACE_WITH_GOOGLE_CLIENT_SECRET"

# WhatsApp Business Cloud API / Webhook
WHATSAPP_API_TOKEN="REPLACE_WITH_META_WHATSAPP_CLOUD_API_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="REPLACE_WITH_PHONE_NUMBER_ID"
WHATSAPP_VERIFY_TOKEN="REPLACE_WITH_WHATSAPP_WEBHOOK_VERIFY_TOKEN"
